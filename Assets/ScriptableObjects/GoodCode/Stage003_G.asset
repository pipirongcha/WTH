  StageNameCode: public List<int> Stage_
  StageCode: "(List<int> numbers, int min, int max)\r\n    {\r\n        List<int>
    filtered = new List<int>();\r\n\r\n        foreach (int number in numbers)\r\n       
    {\r\n            if (number >= min && number <= max)\r\n            {\r\n               
    filtered.Add(number);\r\n            }\r\n        }\r\n\r\n        return filtered;\r\n   
    }\r\n}"
