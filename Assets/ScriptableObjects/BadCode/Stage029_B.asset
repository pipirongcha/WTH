  CodeTitleTXT: "\uBCC0\uC218\uBA85 \uC911\uBCF5(B)"
  CodeMainTXT: "\uADF8\uB7EC\uB2C8\uAE4C... \uC774 numbers\uAC00 \uC800 numbers\uC778\uAC70\uC8E0..?"
  IsItGood: 0
  StageCodeFile: {fileID: 4900000, guid: f5ebcde554235094e9f6a883025dd05e, type: 3}
  StageNameCode: public void Stage_
  StageCode: "(List<int> numbers)\r\n    {\r\n        List<int> evens = new List<int>();\r\n       
    List<int> odds = new List<int>();\r\n\r\n        foreach (int numbers in numbers)\r\n       
    {\r\n            if (numbers % 2 == 0)\r\n                evens.Add(numbers);\r\n           
    else\r\n                odds.Add(numbers);\r\n        }\r\n\r\n        Console.WriteLine(\"Even
    numbers: \" + string.Join(\", \", evens));\r\n        Console.WriteLine(\"Odd
    numbers: \" + string.Join(\", \", odds));\r\n    }\r\n}"
  StageAnimation: {fileID: 0}
