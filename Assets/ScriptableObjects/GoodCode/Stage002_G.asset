  StageCodeFile: {fileID: 4900000, guid: 5172945508c10924cab5d76016ae7e0f, type: 3}
  StageNameCode: public string Stage_
  StageCode: "(int number, int baseValue)\r\n    {\r\n        if (baseValue < 2 ||
    baseValue > 16)\r\n            throw new ArgumentException(\"baseValue must be
    between 2 and 16.\");\r\n\r\n        if (number == 0) return \"0\";\r\n\r\n       
    const string chars = \"0123456789ABCDEF\";\r\n        string result = string.Empty;\r\n\r\n       
    while (number > 0)\r\n        {\r\n            result = chars[number % baseValue]
    + result;\r\n            number /= baseValue;\r\n        }\r\n\r\n        return
    result;\r\n    }\r\n}"
  StageAnimation: {fileID: 0}
