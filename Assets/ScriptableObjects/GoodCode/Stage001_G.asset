  StageCodeFile: {fileID: 4900000, guid: 864a9fe01a179a743992f945afd4375c, type: 3}
  StageNameCode: public int Stage_
  StageCode: "(int a, int b)\r\n    {\r\n        while (b != 0)\r\n        {\r\n           
    int sum = a ^ b;\r\n\r\n            int carry = (a & b) << 1;\r\n\r\n           
    a = sum;\r\n\r\n            b = carry;\r\n        }\r\n        \r\n        return
    a;\r\n    }\r\n}"
