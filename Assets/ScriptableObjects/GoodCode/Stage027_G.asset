  CodeTitleTXT: "\uC758\uB3C4\uB300\uB85C \uB3D9\uC791\uC740 \uC548\uD574\uB3C4(G)"
  CodeMainTXT: "\"\uC2E4\uD589 \uBC0F \uC815\uC0C1 \uC885\uB8CC\uAC00 \uB418\uB294
    \uBA54\uC11C\uB4DC\uC5D0\uB294 '\uC2E4\uD589\uD558\uAE30' \uBC84\uD2BC\uC744
    \uB20C\uB7EC\uC8FC\uC138\uC694\""
  IsItGood: 1
  StageCodeFile: {fileID: 4900000, guid: 0d7d2dc82bc42db498411b2acb304a41, type: 3}
  StageNameCode: public bool Stage_
  StageCode: "(int num1, int num2) \r\n    {\r\n        bool isEven = num1 % 2 ==
    0 & num2 % 2 == 0;\r\n        bool isDivisibleBy3 = num1 % 3 == 0 | num2 % 3
    == 0;\r\n\r\n        if (isEven | isDivisibleBy3)\r\n        {\r\n           
    return true;\r\n        }\r\n\r\n        return false;\r\n    }\r\n}"
