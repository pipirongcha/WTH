  CodeTitleTXT: "\uBE44\uD2B8\uC5F0\uC0B0 \uB367\uC148(G)"
  CodeMainTXT: "\uBE44\uD2B8\uC5F0\uC0B0\uC73C\uB85C \uB367\uC148\uD574\uC694"
