  StageNameCode: public void Stage_
  StageCode: "(int n)\r\n    {\r\n        string a = n.ToString();\r\n        int
    b = a.Length;\r\n        for (int i = 0; i < b / 2; i++)\r\n        {\r\n           
    if (a[i] != a[b - 1 - i])\r\n                return false;\r\n        }\r\n       
    return true;\r\n    }\r\n}"
