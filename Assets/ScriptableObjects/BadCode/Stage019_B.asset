  StageNameCode: public void Stage_
  StageCode: "()\r\n    {\r\n        int count = 0;\r\n        bool condition = true;\r\n\r\n       
    while (condition)\r\n        {\r\n           \r\n            count = (count *
    2 + 5) / 3;\r\n\r\n            if (count % 5 == 0 && count % 7 != 0)\r\n           
    {\r\n                condition = !condition;\r\n            }\r\n\r\n           
    if (count < 0 || count % 11 == 3)\r\n            {\r\n                count =
    (count * count - 1000) / 10;\r\n            }\r\n\r\n            Console.WriteLine(count);\r\n       
    }\r\n    }\r\n}"
