      m_Calls: []
  m_text: "\n\n\u201C 8\uAC1C\uC758 \uBA54\uC11C\uB4DC\uB97C \uC5F0\uC18D\uC73C\uB85C
    \uC644\uBCBD \uAC80\uD1A0\uD558\uC5EC, \uD074\uB798\uC2A4\uB97C \uC644\uC131\uD558\uB77C!
    \u201D\n\n\n\uB77C\uC774\uBE0C\uB7EC\uB9AC \uD504\uB85C\uC81D\uD2B8\uC758 \uD074\uB798\uC2A4\uB97C
    \uC644\uC131\uC2DC\uD0A4\uB294 \uAC8C\uC784\uC785\uB2C8\uB2E4. \n\n\uC2E4\uD589
    \uBC0F \uC815\uC0C1 \uC885\uB8CC\uAC00 \uB418\uB294 \uBA54\uC11C\uB4DC\uC5D0\uB294
    '\uC2E4\uD589\uD558\uAE30' \uBC84\uD2BC\uC744 \uB20C\uB7EC\uC8FC\uC138\uC694.\n\n\uADF8\uB807\uC9C0
    \uC54A\uC740 \uBA54\uC11C\uB4DC\uC5D0\uB294 '\uB2D8 \uB300\uCCB4 \uBB50\uD568?'
    \uBC84\uD2BC\uC744 \uB204\uB974\uC154\uC57C \uD569\uB2C8\uB2E4.\n\n\uC5F0\uC18D\uC73C\uB85C
    8\uAC1C \uBA54\uC11C\uB4DC\uB97C \uC131\uACF5\uC801\uC73C\uB85C \uAC80\uD1A0\uD588\uB2E4\uBA74,\n\n\uB2F9\uC2E0\uC758
    \uC2B9\uB9AC\uC785\uB2C8\uB2E4.  \n\n\n\r\n\r\n\r\n\n\n\n\n\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 409bdca149a6b4b4799af4f8d1f131a2, type: 2}
