  StageCodeFile: {fileID: 4900000, guid: bdcf7a8c4bbf970449d2474b7012fb97, type: 3}
  StageNameCode: public void Stage_
  StageCode: "(int[] numbers)\r\n    {\r\n        int evenSum = 0, oddSum = 0;\r\n\r\n       
    foreach (int num in numbers)\r\n        {\r\n            if (num % 2 == 0)\r\n               
    evenSum += num;\r\n            else\r\n                oddSum += num;\r\n       
    }\r\n\r\n        Console.WriteLine($\"Even Sum: {evenSum}, Odd Sum: {oddSum}\")\r\n   
    }\r\n}"
  StageAnimation: {fileID: 0}
